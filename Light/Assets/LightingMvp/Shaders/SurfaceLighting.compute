#pragma kernel EvaluateSurfaceLighting
#pragma target 4.5

struct SurfaceSample { float3 position; float area; float3 normal; float padding; float4 albedo; };
struct LightSpecGpu
{
    float3 position; float intensity; float3 direction; float range;
    float4 color; float attenuation; float cosInner; float cosOuter; int kind;
};
StructuredBuffer<SurfaceSample> _Samples;
StructuredBuffer<LightSpecGpu> _Lights;
RWStructuredBuffer<float4> _Irradiance;
RWStructuredBuffer<float4> _OutgoingRadiance;
uint _SampleCount;
uint _LightCount;

[numthreads(64,1,1)]
void EvaluateSurfaceLighting(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _SampleCount) return;
    SurfaceSample s = _Samples[id.x];
    float3 irradiance = 0;
    for (uint l = 0; l < _LightCount; l++)
    {
        LightSpecGpu light = _Lights[l];
        float3 delta = light.position - s.position;
        float distance2 = max(dot(delta,delta),1e-12);
        float3 omega = delta * rsqrt(distance2);
        float cosine = max(0,dot(s.normal,omega));
        float window = max(0,1-distance2/(light.range*light.range));
        float distanceAttenuation = light.attenuation/(light.attenuation+distance2)*window*window;
        float angular = 1;
        if (light.kind == 1)
        {
            float coneCosine = dot(-omega,normalize(light.direction));
            float cone = saturate((coneCosine-light.cosOuter)/max(light.cosInner-light.cosOuter,1e-8));
            angular = cone*cone;
        }
        irradiance += light.intensity*light.color.rgb*distanceAttenuation*angular*cosine;
    }
    _Irradiance[id.x] = float4(irradiance,1);
    // Lambertian L_o = rho/pi * E. This is outgoing surface radiance, not a tonemapped screen pixel.
    _OutgoingRadiance[id.x] = float4(irradiance*s.albedo.rgb/3.14159265359,1);
}
